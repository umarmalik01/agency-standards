# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# There are NO generation-provider API keys in this project, by design.
# If you ever find yourself adding FAL_KEY, REPLICATE_API_TOKEN, ELEVENLABS_API_KEY or similar,
# stop: that is a policy violation and scripts/audit_no_paid_apis.py will fail the build.

# Optional. Only needed to DEPLOY the Hugging Face Space (free account).
# Not used for generation, and never required to run anything locally.
HF_TOKEN=

# Optional overrides
TARJEEH_WAN_MODEL=Wan-AI/Wan2.2-TI2V-5B-Diffusers
MUSETALK_HOME=third_party/MuseTalk
TARJEEH_JOBS=./projects

# Optional. Public URL of your deployed free ZeroGPU Space, e.g. https://<user>-tarjeeh-ugc-ai.hf.space
TARJEEH_SPACE_URL=
